NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/christ_is_victor
MONGODB_URI_TEST=mongodb://localhost:27017/christ_is_victor_test

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

LOGIN_OTP_TTL_MINUTES=10
DEFAULT_LOGIN_OTP=3303
OTP_SERVICE_ENABLED=false

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# REDIS CONFIGURATION
# Set USE_REDIS to true to use Redis for Cache and Rate Limiting
USE_REDIS=false
REDIS_URI="redis://default:redispw@localhost:6379"

# AWS S3 (File Storage — Images, Audio, PDFs)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME=""

# ELEVENLABS (Text-to-Speech)
# Get your API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY="sk_42da74ae049c290e913dd09dac3838466d9057a52988da72"
# Voice ID — default: Rachel (calm, clear English)
# Browse voices at https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID="4Mhjd1Q9JRWcKfDQvn26"
# Model — eleven_multilingual_v2 (best quality) | eleven_flash_v2_5 (fastest)
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
